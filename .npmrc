# @vercel/analytics + @vercel/speed-insights declare OPTIONAL framework peers
# (Next, SvelteKit, Nuxt, …). npm's strict resolver tries to satisfy the
# SvelteKit one, which drags in vite 8 and conflicts with the repo's vite 5
# (from vitest). We don't use those frameworks; relax strict optional-peer
# resolution so clean installs (local + Vercel + CI) succeed.
legacy-peer-deps=true
